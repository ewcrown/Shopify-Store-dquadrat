    "text_columns_3PygVx": {
      "type": "text-columns",
      "blocks": {
        "text_4zjExR": {
          "type": "text",
          "settings": {
            "title": "Wir sind für Sie da",
            "caption": "<p>Ob für Teeneulinge, Teekenner oder Teeliebhaber: Wir beraten Sie gerne und helfen Ihnen bei der Suche nach Ihrem Lieblingstee weiter!</p>",
            "seo_h_tag": "h3"
          }
        },
        "text_6rj6Y7": {
          "type": "text",
          "settings": {
            "title": "Unser Tee Fachgeschäft",
            "caption": "<p>Seit 1980 sind wir mit unserem Ladengeschäft Tee und Kräutergalerie in Ludwigsburg für Sie da und beraten Sie kompetent für höchsten Teegenuss zu unseren erlesenen und ausgewähltem Teesorten aus aller Welt.</p>",
            "seo_h_tag": "h3"
          }
        },
        "text_6fYbPg": {
          "type": "text",
          "settings": {
            "title": "Wir lieben Tee",
            "caption": "<p>Unsere Teammitglieder sind leidenschaftliche Teeliebhaber und stets bereit, neue Teesorten kennenzulernen. Diese Begeisterung für Tee spiegelt sich sowohl in ihrer fachlichen Kompetenz als auch in ihrer Freude wider, ihr Tee-Wissen zu teilen.</p>",
            "seo_h_tag": "h3"
          }
        }
      },
      "block_order": [
        "text_4zjExR",
        "text_6rj6Y7",
        "text_6fYbPg"
      ],
      "settings": {
        "layout": "grid-3 grid-lap-1",
        "block_text_alignment": "text-align--center",
        "gutter_decrease": false,
        "seo_h_tag": "h2"
      }
    },
