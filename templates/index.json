      "blocks": {
        "ee1e988a-b615-4b5e-9679-53baf1a4972c": {
          "type": "tab",
          "settings": {
            "title": "Frisch",
            "caption": "<p>Wir bestellen wöchentlich unsere Tees, so bleiben sie besonders frisch. </p>",
            "image": "shopify://shop_images/1_41aa2f34-5e58-4ff8-88e0-3e23945699d4.png",
            "icon": "favorite"
          }
        },
        "1662660652b48c92de-1": {
          "type": "tab",
          "settings": {
            "title": "Natürlich",
            "caption": "<p>Das Wort Aroma kommt aus dem Griechischen und bedeutet ursprünglich Gewürz.<br/>Ein Aroma setzt sich aus vielen einzelnen Aromastoffen zusammen. In unseren<br/>Tees befindet sich kein künstliches Aroma. Unsere Händler verwenden<br/>ausschließlich natürliche und naturidentische Aromen. </p>",
            "image": "shopify://shop_images/2.png",
            "icon": "favorite"
          }
        },
        "1662660652b48c92de-2": {
          "type": "tab",
          "settings": {
            "title": "Hochwertig",
            "caption": "<p>Wir legen sehr großen Wert auf Qualität und wählen unsere Lieferanten sorgfältig aus.</p>",
            "image": "shopify://shop_images/onlineshop_bilder_quadratisch.png",
            "icon": "favorite"
          }
        },
        "1662660652b48c92de-0": {
          "type": "tab",
          "settings": {
            "title": "Bio-Zertifiziert",
            "caption": "<p>Unsere Bio <a href=\"/collections/biotee\" target=\"_blank\" title=\"Alle Biotees\">Tees</a> sind nach DE-ÖKO-006 Bio zertifiziert. Mehr dazu erfahren Sie <a href=\"/pages/bio-zertifizierung\" target=\"_blank\" title=\"Bio Zertifizierung\">hier.</a></p>",
            "image": "shopify://shop_images/bio-logo-dquadrat.png",
            "icon": "favorite"
          }
        }
      },
