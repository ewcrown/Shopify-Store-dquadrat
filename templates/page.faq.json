    "16572870464af1cd4d": {
      "type": "accordions",
      "blocks": {
        "13449687-9343-40e5-b39d-0e9131924e4c": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Die kleinen Knöpfe an der Schürze fehlen/sind abgefallen. Kann ich das Dirndl dann reklamieren?",
            "text": "<p>Nein, dies ist kein Reklamationsgrund, da man ohnehin nach Erhalt des Dirndls, die zwei transparenten Knöpfe abschneiden sollte. Diese sind nur für den Transport der Schürze gedacht, da die Schürze direkt auf der Taille getragen werden sollte.</p>",
            "open": false
          }
        },
        "16572870464dcbabd2-0": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Sind einzelne Schürzen erhältlich?",
            "text": "<p>Nein, die Schürzen werden immer nur <strong>zusammen</strong> mit dem Dirndl produziert und sind daher nicht einzeln erhältlich.</p>",
            "open": false
          }
        },
        "16572870464dcbabd2-1": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Welche Größe ist die richtige Größe für mich?",
            "text": "<p>Hier empfiehlt sich ein Blick in unsere <a href=\"/pages/grossenberatung-1\" title=\"Größenberatung\">Größenberatung.</a></p>",
            "open": false
          }
        },
        "16572870464dcbabd2-2": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Kann ich einen Artikel vorab reservieren?",
            "text": "<p>Nein, wir bieten keine Vorab-Reservierungen von Artikeln an.</p>",
            "open": false
          }
        },
        "ee6adfd9-768e-4d03-baac-881f8ec83e03": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Hat jedes Dirndl Taschen?",
            "text": "<p>Ja, die Dirndl von Krüger haben alle Taschen, diese findest du unterhalb der Schürze.</p>",
            "open": false
          }
        },
        "6609fff3-e585-452d-96eb-ac30357199f8": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Wie kann ich mein Trachtenoutfit pflegen?",
            "text": "<p><a href=\"/pages/lederhose-reinigen\" title=\"Lederhose reinigen\">Lederhose reinigen.</a></p><p><a href=\"/pages/darf-mein-dirndl-in-die-waschmaschine\" title=\"Darf mein Dirndl in die Waschmaschine?\">Darf mein Dirndl in die Waschmaschine?</a></p>",
            "open": false
          }
        },
        "96f9f2aa-db4b-47c4-bd84-f30d635a5b38": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Mein Dirndl ist zu eng geworden, was kann ich tun?",
            "text": "<p>Im Mieder deines Krüger-Dirndls ist auf beiden Seiten eine Nahtzugabe. Hier kannst du dein Dirndl bis zu einer Größe größer auslassen. </p>",
            "open": false
          }
        }
      },
