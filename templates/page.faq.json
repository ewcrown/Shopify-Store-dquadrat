        "1633681707d0a1c902-0": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Wo kann ich den Rabattcode/Gutschein eingeben?",
            "text": "<p>Dies ist im Warenkorb beim Checkout möglich. Es kann nur ein Code pro Bestellung eingelöst werden.</p>",
            "open": false
          }
        },
        "5cb11ecd-702b-49ea-a078-b233faf22ad5": {
          "type": "accordion",
          "settings": {
            "icon": "none",
            "title": "Wo kann ich einen Gutschein kaufen?",
            "text": "<p>Entweder in einem unserer lokalen Stores oder hier: <a href=\"/products/dquadrat-gutschein\" target=\"_blank\" title=\"DQUADRAT - Gutschein\">Gutschein</a></p>",
            "open": false
